{"id": "brain-14", "kind": "tool_chain", "persona": "brain", "prompt": "Analyze WLDUSDT for a trade.", "must_call": ["get_derivatives_context", "get_news_sentiment"], "answer_must_not_match": ["(?s)no derivatives data.*limit", "(?s)(absence|lack) of .{0,40}(news|derivatives).{0,80}(speculative|not recommend|limit|no trade|avoid|stay (out|away))"], "answer_must_match": ["\\b(if|once|when)\\b.{0,60}\\b(above|below|reclaims?|breaks?|holds?)\\b.{0,30}\\d|\\bclose (above|below) \\d|\\b(above|below) \\d[\\d.]* would trigger"]}
